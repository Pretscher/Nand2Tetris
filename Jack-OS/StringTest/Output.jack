class Output {
    static Array charMaps;
    static int row, col, width, height;

    function void init() {
        let width = 64;
        let height = 23;
        do Output.initMap();
        return;
    }

    //every element in the array created is a line, if we poke the integer somewhere in the screen memory, the entire line is drawn
    function void create(int index, int a, int b, int c, int d, int e, int f, int g, int h, int i, int j, int k) {
        var Array map;
        let map = Array.new(11);
        let charMaps[index] = map;
        let map[0] = a; let map[1] = b; let map[2] = c;
        let map[3] = d; let map[4] = e; let map[5] = f;
        let map[6] = g; let map[7] = h; let map[8] = i;
        let map[9] = j; let map[10] = k;
        return;
    }

