    function void moveCursor(int i, int j) {
        let row = i;
        let col = j;
        do Output.printChar(32);//write over the current char with a blank
        let row = i;
        let col = j;
        return;
    }

    function void backSpace() {
        if(col = 0) {
            return;//we dont change row then, but do nothing
        } else {
            let col = col - 1;
        }
        do Output.printChar(32);//write over the current char with a blank   
        let col = col - 1;
        return;
    }

    function void printChar(char c) {
        var Array map;
        var int startAddress, i, actualRow, actualCol;
        var int oldMem;

        //draw character----------------------------------------------------------------------------------------------------------------------------------
        let map = charMaps[c];//c should instantly be converted to its integer representation, which is also the index in the array
        let i = 0;
        while(i < 11) {
            let actualRow = row * 11 + i;
            //we cant be more precise than 16 bit, if we dont want use use drawPixel, which would be incredibly inefficient. 
            //Thus we have to split the column, that is represented by an int, into two parts in binary.
            let actualCol = col * 8;
            let startAddress = 16384 + (32 * actualRow) + (actualCol / 16);
            
            let oldMem = Memory.peek(startAddress);//if one of the two parts of the 16 bits are already written, we want to preserve that
            if(Math.modulo(col, 2) = 1) {
                let oldMem = oldMem & 255;//erase first 8 bits by doing an and with 0000 0000 1111 1111
                do Memory.poke(startAddress, (map[i] * 256) + oldMem);//shift the part we want to write left, and keep the old right part by adding it
            }
            else {
                let oldMem = oldMem & -256;//erase last 8 bits by doing an and with 1111 1111 0000 0000
                do Memory.poke(startAddress, map[i] + oldMem);//left in binary is oldMem, right is map[i]
            }
            let i = i + 1;
        }
        
        //advance--------------------------------------------------------------------------------------------------------------------------------------------
        if(col = (width - 1)) {
            if(row = (height - 1)) {
                let row = 0;
            } else {
                let row = row + 1;
            }
            let col = 0;
        } else {
            let col = col + 1;
        }
        return;
    }

    function void printInt(int i) {
        var int currentDigit, j;
        var Array characters;
        if(i < 0) {
            do Output.printChar(45);
            let i = - i;
        }
        let characters = Array.new(16);//16 is the max amount of digits for an int
        let j = 0;
        while (i > 0) {
            let characters[j] = 48 + Math.modulo(i, 10);//add the start of digits in our char table
            let i = i / 10;
            let j = j + 1;
        }
        //print in reverse
        while(j > -1) {
            if(~(characters[j] = 0)) {
                do Output.printChar(characters[j]);
               // do Output.printChar(80);
            }
            let j = j - 1;
        }
        do characters.dispose();
        return;
    }

    function void println() {
        let row = row + 1;
        let col = 0;
        return;
    }

    function void printString(String str) {
        var int i, length;
        let length = str.length();
        let i = 0;
        while(i < length) {
            do Output.printChar(str.charAt(i));
            let i = i + 1;
        }
        return;
    }

}
